{
  "buildCommand": "npx quartz build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/static/robots.txt" }
  ],
  "redirects": [
    { "source": "/themes/:path*", "destination": "/archive/:path*", "permanent": true },
    { "source": "/index", "destination": "/archive/@Index", "permanent": true }
  ]
}
